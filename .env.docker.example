# Copy to .env.docker (gitignored), then fill in WF_SECRET_KEY.
#
#   cp .env.docker.example .env.docker
#   echo "WF_SECRET_KEY=$(openssl rand -base64 32)" >> .env.docker
#
# This key encrypts the container's secret store — the one that will hold your
# Trading 212 API key pair once you enter it in the addon. Lose it and the
# stored credentials become unreadable; the fix is to re-enter them.

WF_SECRET_KEY=

# Host port for http://127.0.0.1:<port>
WF_PORT=8088
