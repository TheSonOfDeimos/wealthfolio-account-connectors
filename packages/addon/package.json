{
  "name": "@t212/addon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wealthfolio addon that imports Trading 212 orders",
  "main": "dist/addon.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio-addon dev",
    "clean": "rm -rf dist",
    "package": "zip -r dist/trading212-import-$npm_package_version.zip manifest.json dist/ README.md -x '*.map' -x '*.zip'",
    "bundle": "pnpm clean && pnpm build && pnpm package",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@t212/core": "workspace:*"
  },
  "peerDependencies": {
    "@wealthfolio/addon-sdk": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@wealthfolio/addon-dev-tools": "^3.6.2",
    "@wealthfolio/addon-sdk": "^3.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.2"
  }
}
