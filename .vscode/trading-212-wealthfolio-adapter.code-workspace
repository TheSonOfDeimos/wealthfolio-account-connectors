{
  "folders": [
    {
      "path": "..",
      "name": "trading-212-wealthfolio-adapter"
    }
  ],
  "settings": {
    // ===== VS Code core =====
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/*.zip": true
    },
    "workbench.editorAssociations": {
      "*.md": "vscode.markdown.preview.editor"
    },
    "files.exclude": {
      "**/.DS_Store": true
    },
    // Nothing here reacts to a save — deploying is an explicit task — so
    // auto-save is free of side effects.
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,

    // ===== TypeScript =====
    // Use the workspace compiler (5.9.3) rather than the one VS Code bundles
    // (6.x), so the editor and `pnpm type-check` agree.
    //
    // The path is relative to THIS FILE, not to the folder above — a workspace
    // file resolves it from its own directory. Hence the `../`. You must also
    // run "TypeScript: Select TypeScript Version → Use Workspace Version"
    // once: it is a trust-restricted setting and is ignored until then.
    "js/ts.tsdk.path": "../node_modules/typescript/lib",
    "js/ts.preferences.importModuleSpecifier": "relative",
    "[typescript]": {
      "editor.formatOnSave": true
    },
    "[typescriptreact]": {
      "editor.formatOnSave": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      // ===== Addon =====
      {
        // clean → type-check → vite build → zip. The type-check is the reason
        // this is one task: vite strips types without checking them, so a
        // build alone can package code that does not compile.
        "label": "Addon: bundle (zip)",
        "type": "shell",
        "command": "pnpm",
        "args": ["bundle"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": ["$tsc"],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "panel": "dedicated",
          "clear": false
        }
      },

      {
        // Bundles, then installs into the running Wealthfolio container over
        // its HTTP API. Reload the browser tab afterwards to pick it up.
        "label": "Addon: deploy to Wealthfolio",
        "type": "shell",
        "command": "pnpm",
        "args": ["dev:deploy"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": ["$tsc"],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        }
      },

      // ===== Smoke test (hits the LIVE Trading 212 API, read-only) =====
      {
        "label": "Addon: smoke test (live)",
        "type": "shell",
        "command": "pnpm",
        "args": ["smoke:live"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": [],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        }
      },

      // ===== Wealthfolio test instance (Docker) =====
      {
        "label": "Wealthfolio: up",
        "type": "shell",
        "command": "docker",
        "args": ["compose", "--env-file", ".env.docker", "up", "-d"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "panel": "dedicated",
          "clear": false
        }
      },
      {
        "label": "Wealthfolio: logs",
        "type": "shell",
        "command": "docker",
        "args": ["compose", "--env-file", ".env.docker", "logs", "-f"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "panel": "dedicated",
          "clear": false
        }
      },
      {
        "label": "Wealthfolio: down",
        "type": "shell",
        "command": "docker",
        "args": ["compose", "--env-file", ".env.docker", "down"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "echo": true,
          "reveal": "always",
          "panel": "dedicated",
          "clear": false
        }
      },
      {
        // Opens in VS Code's built-in Simple Browser rather than the system
        // default. Tasks can only run shell commands, so the actual work is
        // done by the `openWealthfolio` input below — a `command` input runs
        // when the task starts. The shell part is a no-op that forces it.
        //
        // Not the default browser on purpose: Safari cannot host Wealthfolio's
        // addon sandbox (it blocks blob: module imports from the iframe's
        // opaque origin). Simple Browser is a Chromium webview, so it can.
        "label": "Wealthfolio: open in editor",
        "type": "shell",
        "command": "true",
        "args": ["${input:openWealthfolio}"],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "silent",
          "panel": "shared",
          "clear": false
        }
      }
    ],
    "inputs": [
      {
        "id": "openWealthfolio",
        "type": "command",
        "command": "simpleBrowser.api.open",
        "args": ["http://127.0.0.1:8088"]
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        // Breakpoints work in scripts/ and src/ — tsx emits source maps and
        // Node maps them back to the TypeScript.
        "name": "Smoke test (debug)",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/smoke-live.ts",
        "runtimeArgs": ["--import", "tsx"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "sourceMaps": true,
        "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
      },
      {
        // js-debug's "Web App (Integrated Browser)": a Chromium browser in an
        // editor tab WITH the debugger attached, so console output and network
        // calls land in the Debug Console. Chromium, so unlike Safari it can
        // host the addon sandbox.
        "name": "Wealthfolio (integrated browser)",
        "type": "editor-browser",
        "request": "launch",
        "url": "http://127.0.0.1:8088",
        "webRoot": "${workspaceFolder}"
      },
      {
        // Same thing in a real Chrome window. Worth having when you need the
        // full DevTools panel — element inspection, the network waterfall —
        // rather than just the Debug Console.
        "name": "Wealthfolio (Chrome + DevTools)",
        "type": "chrome",
        "request": "launch",
        "url": "http://127.0.0.1:8088",
        "webRoot": "${workspaceFolder}"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "ms-azuretools.vscode-docker",
      "bierner.markdown-mermaid"
    ],
    "unwantedRecommendations": []
  }
}
