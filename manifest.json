{
  "id": "trading212-import",
  "name": "Trading 212 Import",
  "version": "0.1.0",
  "description": "Pulls filled orders from your Trading 212 account and imports them into Wealthfolio as BUY/SELL activities.",
  "icon": "data:image/png;base64,",
  "author": "Lev Kargalov",
  "license": "MIT",
  "main": "dist/addon.js",
  "sdkVersion": "3.6.2",
  "minWealthfolioVersion": "3.6.2",
  "enabled": true,
  "keywords": [
    "wealthfolio",
    "addon",
    "trading212",
    "import",
    "broker"
  ],
  "network": {
    "allowedHosts": [
      "live.trading212.com"
    ]
  },
  "hostDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@wealthfolio/addon-sdk": "^3.6.2"
  },
  "contributes": {
    "routes": [
      {
        "id": "trading212-import"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "trading212-import",
          "route": "trading212-import",
          "label": "Trading 212",
          "icon": "trend-up",
          "order": 100
        }
      ]
    }
  },
  "permissions": [
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "Read your order history from live.trading212.com. Only GET requests are made; the addon never places or cancels orders."
    },
    {
      "category": "secrets",
      "functions": [
        "set",
        "get",
        "use",
        "delete"
      ],
      "purpose": "Keep your Trading 212 API key and secret in the keyring, and let Wealthfolio attach them to Trading 212 requests without the addon reading them back. 'use' is what the network broker needs to resolve auth.secretKey."
    },
    {
      "category": "accounts",
      "functions": [
        "getAll",
        "create"
      ],
      "purpose": "Let you pick which Wealthfolio account the imported trades belong to, or create a new one named by you that mirrors your Trading 212 account."
    },
    {
      "category": "activities",
      "functions": [
        "getAll",
        "saveMany",
        "getImportMapping",
        "saveImportMapping"
      ],
      "purpose": "Write the mapped records once you confirm, recognise what was already imported so a repeat sync adds only what is new, and store your ticker corrections in Wealthfolio's own per-account symbol mappings. Removing is used only by Wipe and reload, and only for rows this addon imported."
    },
    {
      "category": "portfolio",
      "functions": [
        "recalculate",
        "getHoldings"
      ],
      "purpose": "Ask Wealthfolio to revalue the portfolio after an import, and read back your holdings to check that each Trading 212 instrument resolved to the right symbol."
    },
    {
      "category": "market-data",
      "functions": [
        "searchTicker",
        "syncHistory"
      ],
      "purpose": "Look up ticker symbols while you correct one, and ask Wealthfolio to fetch prices and exchange rates for the instruments and currencies an import introduces, so a fresh install is not left reporting missing rates."
    },
    {
      "category": "assets",
      "functions": [
        "getProfile",
        "updateProfile"
      ],
      "purpose": "Read the currency Wealthfolio assigned to each imported security and correct it when it disagrees with the one Trading 212 states, so a London line quoted in pounds is not read as pence."
    }
  ]
}
