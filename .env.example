# Trading 212 credentials for the Node scripts only — `pnpm smoke:live` and
# `pnpm symbols:generate`. The addon does NOT read this file: it asks for the
# key pair in its own form and keeps it in Wealthfolio's keyring.
#
# Copy to `.env` (which git ignores) and fill in. Generate the pair in the
# Trading 212 app under Settings → API; read access is all that is needed.
T212_API_KEY=
T212_API_SECRET=
