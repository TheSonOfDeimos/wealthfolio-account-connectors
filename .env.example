# Copy to .env and fill in. Used ONLY by `pnpm smoke:live`, which calls the
# real Trading 212 API from Node — the addon itself reads credentials from the
# OS keyring, never from this file.
#
# Generate a key pair in the Trading 212 mobile app (Settings -> API):
# https://helpcentre.trading212.com/hc/en-us/articles/14584770928157-Trading-212-API-key
#
# .env is gitignored. Keep it that way.

T212_API_KEY=
T212_API_SECRET=

# Optional: set to the demo host to rehearse against paper money.
# T212_BASE_URL=https://demo.trading212.com/api/v0
