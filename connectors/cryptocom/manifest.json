{
  "id": "cryptocom-import",
  "name": "Crypto.com Import",
  "version": "0.1.0",
  "description": "Reads your Crypto.com Exchange history \u2014 trades, deposits, withdrawals and staking rewards \u2014 and imports it into Wealthfolio.",
  "author": "Lev Kargalov",
  "license": "AGPL-3.0-or-later",
  "main": "dist/addon.js",
  "sdkVersion": "3.6.2",
  "minWealthfolioVersion": "3.6.2",
  "enabled": true,
  "keywords": [
    "wealthfolio",
    "addon",
    "crypto.com",
    "crypto",
    "import",
    "exchange"
  ],
  "network": {
    "allowedHosts": [
      "api.crypto.com"
    ],
    "approvedHosts": [
      "api.crypto.com"
    ]
  },
  "hostDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@wealthfolio/addon-sdk": "^3.6.2"
  },
  "contributes": {
    "routes": [
      {
        "id": "cryptocom-import"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "cryptocom-import",
          "route": "cryptocom-import",
          "label": "Crypto.com",
          "icon": "bank",
          "order": 102
        }
      ]
    }
  },
  "permissions": [
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "Read your balances and history from api.crypto.com. Only query endpoints are called: the addon never places an order, stakes or unstakes, converts, or withdraws."
    },
    {
      "category": "secrets",
      "functions": [
        "set",
        "get",
        "delete"
      ],
      "purpose": "Keep your Crypto.com Exchange API key and secret in the keyring. Unlike a broker the host can authenticate for us, Crypto.com signs each request with an HMAC over the method, a nonce and the request body, so the addon must read the secret back to compute that signature. 'use' is not requested \u2014 the host cannot build this signature itself."
    },
    {
      "category": "accounts",
      "functions": [
        "getAll",
        "create"
      ],
      "purpose": "Let you pick which Wealthfolio account the imported history belongs to, or create a new one named by you."
    },
    {
      "category": "activities",
      "functions": [
        "getAll",
        "saveMany"
      ],
      "purpose": "Write the mapped history once you confirm, and recognise what was already imported so a repeat sync adds only what is new."
    },
    {
      "category": "portfolio",
      "functions": [
        "recalculate",
        "getHoldings"
      ],
      "purpose": "Ask Wealthfolio to revalue the portfolio after an import, and read back your holdings to compare them against the value Crypto.com states for the same positions."
    },
    {
      "category": "market-data",
      "functions": [
        "searchTicker",
        "syncHistory",
        "sync",
        "getProviders"
      ],
      "purpose": "Look up ticker symbols while you correct one, fetch prices for the assets an import introduces so a fresh install is not left reporting missing rates, and refresh a specific asset after its price source is changed to Crypto.com's own tickers."
    },
    {
      "category": "assets",
      "functions": [
        "getProfile",
        "updateProfile",
        "updateQuoteMode"
      ],
      "purpose": "Read the currency and name Wealthfolio assigned to each imported asset and correct them when they disagree with what Crypto.com states. Also set the quote mode of the `$CASH` placeholder to MANUAL: every row pointing at it is a cash flow — interest, fees, deposits — never a trade, so there is no instrument to price, and leaving it on automatic updates makes every enabled provider fail on a ticker that cannot exist."
    },
    {
      "category": "quotes",
      "functions": [
        "getHistory",
        "update"
      ],
      "purpose": "Read the source of each asset's latest quote, so the addon can confirm that a price actually came from Crypto.com rather than reporting success because a stale price happened to still be there. Also write the daily closes the import already fetched into Wealthfolio's own quote history, so the deep past is priced day by day rather than in weekly buckets — the provider form takes a single URL and cannot page, but the import can."
    }
  ],
  "icon": "data:image/png;base64,"
}
