{
  "name": "wealthfolio-account-connectors",
  "version": "0.1.0",
  "private": true,
  "description": "Connect your brokers and banks to Wealthfolio — import your account data, in the currency your provider recorded it.",
  "license": "AGPL-3.0-or-later",
  "author": "Lev Kargalov",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSonOfDeimos/wealthfolio-account-connectors.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "pnpm type-check && pnpm -r verify",
    "build": "pnpm -r build",
    "type-check": "tsc --noEmit",
    "clean": "pnpm -r clean",
    "docker:up": "docker compose -f docker/compose.yml --env-file docker/.env.docker up -d",
    "docker:down": "docker compose -f docker/compose.yml --env-file docker/.env.docker down",
    "docker:reset": "docker compose -f docker/compose.yml --env-file docker/.env.docker down -v"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@wealthfolio/addon-sdk": "^3.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}